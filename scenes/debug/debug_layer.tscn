[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/debug/debug_layer.gd" id="1_dbg"]

[node name="DebugLayer" type="Control"]
process_mode = 3
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_dbg")

[node name="DebugButton" type="Button" parent="."]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.55)
offset_left = 16.0
offset_top = 12.0
offset_right = 156.0
offset_bottom = 84.0
focus_mode = 0
theme_override_font_sizes/font_size = 30
text = "DBG"

[connection signal="pressed" from="DebugButton" to="." method="_on_debug_button_pressed"]
